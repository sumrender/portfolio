---
import { links } from '../data/data.ts';
import CtaButton from './ui/CtaButton.astro';
---

<section class="page-section contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap contact-inner">
    <h2 class="display contact-title" id="contact-title">
      <span>Let's work</span>
      <span class="contact-faint">together</span>
    </h2>
    <p class="section-sub">
      Hiring for a product engineer, or a full-stack role? My
      inbox is open.
    </p>
    <div class="contact-actions">
      <CtaButton href="mailto:sumrenders@gmail.com" variant="rust">
        sumrenders@gmail.com
      </CtaButton>
      <div class="contact-links">
        <a href={links.github} target="_blank" rel="noreferrer">GitHub</a>
        <a href={links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <a href={links.twitter} target="_blank" rel="noreferrer">Twitter</a>
        <a href={links.resume} target="_blank" rel="noreferrer">Resume</a>
      </div>
    </div>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Sumrender Singh</p>
      <p>Built with Astro · sumrender.in</p>
    </footer>
  </div>
</section>

<style>
  .contact {
    padding-bottom: 40px;
  }
  .contact-title {
    font-size: clamp(2.8rem, 7vw, 5.8rem);
    margin-bottom: 16px;
  }
  .contact-title span {
    display: block;
  }
  .contact-faint {
    color: var(--headline-faint-warm);
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    margin: 26px 0 54px;
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }
  .contact-links a {
    color: var(--muted);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .contact-links a:hover {
    color: var(--ink);
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    border-top: 1px solid var(--line);
    padding-top: 22px;
    color: var(--muted);
    font-size: 0.86rem;
  }
</style>
