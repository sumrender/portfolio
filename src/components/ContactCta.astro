---
import { links } from '../data/data.js';
---

<section class="page-section contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap contact-inner">
    <h2 class="display contact-title" id="contact-title">
      <span>Let's work</span>
      <span class="contact-faint">together</span>
    </h2>
    <p class="section-sub">
      Hiring for a product engineer, or a full-stack role? My
      inbox is open.
    </p>
    <div class="contact-actions">
      <a class="contact-primary" href="mailto:sumrenders@gmail.com">
        sumrenders@gmail.com
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 12h15" />
          <path d="m13 6 6 6-6 6" />
        </svg>
      </a>
      <div class="contact-links">
        <a href={links.github} target="_blank" rel="noreferrer">GitHub</a>
        <a href={links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <a href={links.twitter} target="_blank" rel="noreferrer">Twitter</a>
        <a href={links.resume} target="_blank" rel="noreferrer">Resume</a>
      </div>
    </div>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Sumrender Singh</p>
      <p>Built with Astro · sumrender.in</p>
    </footer>
  </div>
</section>

<style>
  .contact {
    padding-bottom: 40px;
  }
  .contact-title {
    font-size: clamp(2.8rem, 7vw, 5.8rem);
    margin-bottom: 16px;
  }
  .contact-title span {
    display: block;
  }
  .contact-faint {
    color: #4a453f;
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    margin: 26px 0 54px;
  }
  .contact-primary {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--rust);
    color: var(--rust-ink);
    font-weight: 600;
    font-size: 1.02rem;
    padding: 16px 26px;
    border-radius: 999px;
    transition: transform 0.2s ease;
  }
  .contact-primary:hover {
    transform: translateY(-2px);
  }
  .contact-primary svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }
  .contact-links a {
    color: var(--muted);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .contact-links a:hover {
    color: var(--ink);
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    border-top: 1px solid var(--line);
    padding-top: 22px;
    color: var(--muted);
    font-size: 0.86rem;
  }
</style>
