---
import { site, contact, socials } from '../data/data.ts';
import CtaButton from './ui/CtaButton.astro';
---

<section class="page-section contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap contact-inner">
    <h2 class="display contact-title" id="contact-title">
      <span>{contact.titleTop}</span>
      <span class="contact-faint">{contact.titleBottom}</span>
    </h2>
    <p class="section-sub">
      {contact.sub}
    </p>
    <div class="contact-actions">
      <CtaButton href={`mailto:${contact.email}`} variant="rust">
        {contact.email}
      </CtaButton>
      <div class="contact-links">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noreferrer">{s.shortLabel}</a>
        ))}
      </div>
    </div>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {site.name}</p>
      <p>{contact.footerBuiltWith}</p>
    </footer>
  </div>
</section>

<style>
  .contact {
    padding-bottom: 40px;
  }
  .contact-title {
    font-size: clamp(2.8rem, 7vw, 5.8rem);
    margin-bottom: 16px;
  }
  .contact-title span {
    display: block;
  }
  .contact-faint {
    color: var(--headline-faint-warm);
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    margin: 26px 0 54px;
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }
  .contact-links a {
    color: var(--muted);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .contact-links a:hover {
    color: var(--ink);
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    border-top: 1px solid var(--line);
    padding-top: 22px;
    color: var(--muted);
    font-size: 0.86rem;
  }
</style>
