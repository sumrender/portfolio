---
/* Shared arrow icon. Decorative only — the parent link/button carries
   the accessible name. Parent CSS sizes the svg (width/height). */

interface Props {
  direction?: "right" | "up-right";
}

const { direction = "right" } = Astro.props;

const paths =
  direction === "up-right"
    ? '<path d="M7 17 17 7" /><path d="M8 7h9v9" />'
    : '<path d="M4 12h15" /><path d="m13 6 6 6-6 6" />';
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths}
/>
