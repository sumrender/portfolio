---
/* Section header: eyebrow-free title + optional lede. The heading
   carries its own weight — no kicker. */

interface Props {
  id: string;
  title: string;
  lede?: string;
}

const { id, title, lede } = Astro.props;
---

<h2 class="section-head" id={id}>{title}</h2>
{lede && <p class="section-sub">{lede}</p>}

<style>
  /* Typography comes from utilities.css (.section-head/.section-sub).
     This style block scopes nothing visual — it exists so the component
     is self-describing. */
</style>
