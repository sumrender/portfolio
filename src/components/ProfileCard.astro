---
import { Image } from 'astro:assets';
import Portrait from '../assets/1.jpg';
import { links } from '../data/data.js';

const socials = [
  {
    href: links.github,
    label: "GitHub profile",
    icon: '<path d="M12 3.5a8.5 8.5 0 0 0-2.7 16.6c.4.1.6-.2.6-.4v-1.5c-2.4.5-2.9-1-2.9-1-.4-1-1-1.2-1-1.2-.8-.6.1-.6.1-.6.9.1 1.4.9 1.4.9.8 1.4 2.1 1 2.6.8.1-.6.3-1 .6-1.3-2-.2-4-1-4-4.4 0-1 .3-1.8 1-2.4-.1-.2-.5-1.2.1-2.4 0 0 .8-.2 2.5.9a8.6 8.6 0 0 1 4.6 0c1.7-1.1 2.5-.9 2.5-.9.6 1.2.2 2.2.1 2.4.6.6 1 1.4 1 2.4 0 3.4-2 4.2-4 4.4.4.3.7.9.7 1.9v2.8c0 .2.2.5.6.4a8.5 8.5 0 0 0-2.7-16.6Z"/>',
  },
  {
    href: links.linkedin,
    label: "LinkedIn profile",
    icon: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M8.5 10.5V16"/><circle cx="8.5" cy="8" r="1.1"/><path d="M12 16v-3.2c0-1 .8-1.8 1.9-1.8s1.9.8 1.9 1.8V16"/><path d="M12 10.7V12"/>',
  },
  {
    href: links.twitter,
    label: "Twitter profile",
    icon: '<path d="M4 4.5 10.8 14 4.4 19.5h2.3l5-4.3 4 4.3H20l-7.1-9.9 6.2-5.1h-2.3l-4.4 3.8-3.6-3.8Z"/>',
  },
  {
    href: links.resume,
    label: "Resume",
    icon: '<path d="M6 3.5h8L19 8.5V20a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1Z"/><path d="M13.5 3.5v5.5H19"/><path d="M8.5 13.5h7M8.5 16.5h5"/>',
  },
];
---

<article class="profile-card" aria-label="Profile">
  <svg class="trail trail-top" viewBox="0 0 200 90" fill="none" aria-hidden="true">
    <path
      d="M-8 14 C 40 86, 118 96, 176 8"
      stroke="var(--rust)"
      stroke-width="3"
      stroke-dasharray="8 9"
      stroke-linecap="round"
    />
  </svg>

  <div class="portrait-wrap">
    <Image
      class="portrait"
      src={Portrait}
      alt="Portrait of Sumrender Singh"
      width={560}
      height={700}
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <h2 class="profile-name">Sumrender Singh</h2>

  <div class="badge-row" aria-hidden="true">
    <svg class="trail trail-mid" viewBox="0 0 150 40" fill="none">
      <path
        d="M4 30 C 48 28, 84 22, 112 6"
        stroke="var(--rust)"
        stroke-width="3"
        stroke-dasharray="7 8"
        stroke-linecap="round"
      />
    </svg>
    <span class="flame" title="">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2.8s5.8 4.4 5.8 9.4a5.8 5.8 0 0 1-11.6 0c0-1.9.9-3.5 2-4.8.4 1 1.1 1.8 2.2 2.1-.4-2.5.2-5 1.6-6.7ZM12 21.5a3.4 3.4 0 0 0 3.4-3.4c0-1.4-.9-2.7-2-3.4-.4 1-1 1.6-2 2 .3-1.9-.4-3.5-1.6-4.6-1 1-2.2 2.7-2.2 4.9a3.4 3.4 0 0 0 3.4 3.5Z" />
      </svg>
    </span>
  </div>

  <p class="profile-role">
    A full-stack developer who ships reliable backends and clean interfaces.
  </p>

  <div class="social-row">
    {
      socials.map((s) => (
        <a
          class="social-link"
          href={s.href}
          target="_blank"
          rel="noreferrer"
          aria-label={s.label}
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={s.icon}
          />
        </a>
      ))
    }
  </div>
</article>

<style>
  .profile-card {
    position: relative;
    background: var(--card);
    color: var(--card-ink);
    border-radius: var(--radius);
    padding: 30px 30px 28px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }
  .trail {
    position: absolute;
    pointer-events: none;
  }
  .trail-top {
    top: -6px;
    left: -10px;
    width: 72%;
  }
  .portrait-wrap {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--rust) 0%, var(--rust-deep) 100%);
  }
  .portrait {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(28%) contrast(1.06);
    mix-blend-mode: luminosity;
    transform: scaleX(-1);
  }
  .portrait-wrap::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(224, 104, 42, 0.28), rgba(179, 78, 24, 0.42));
    mix-blend-mode: multiply;
  }
  .profile-name {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(1.8rem, 2.6vw, 2.3rem);
    letter-spacing: -0.02em;
    text-align: center;
    margin: 22px 0 6px;
  }
  .badge-row {
    position: relative;
    display: flex;
    justify-content: center;
    margin: 2px 0 10px;
    min-height: 40px;
  }
  .trail-mid {
    width: 150px;
  }
  .flame {
    position: absolute;
    right: calc(50% - 86px);
    top: -12px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--rust);
    color: #fff;
    display: grid;
    place-items: center;
  }
  .flame svg {
    width: 19px;
    height: 19px;
  }
  .profile-role {
    color: var(--card-muted);
    text-align: center;
    font-size: 1rem;
    max-width: 30ch;
    margin: 0 auto;
  }
  .social-row {
    display: flex;
    justify-content: center;
    gap: 22px;
    margin-top: 22px;
  }
  .social-link {
    color: var(--rust);
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    transition: transform 0.18s ease, background 0.18s ease;
  }
  .social-link:hover {
    transform: translateY(-2px);
    background: rgba(224, 104, 42, 0.12);
  }
  .social-link svg {
    width: 23px;
    height: 23px;
  }
</style>
