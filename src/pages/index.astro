---
import Layout from '../layouts/Layout.astro';
import TopNav from '../components/TopNav.astro';
import ProfileCard from '../components/ProfileCard.astro';
import HeroCopy from '../components/HeroCopy.astro';
import ProjectsGrid from '../components/ProjectsGrid.astro';
import ExperienceList from '../components/ExperienceList.astro';
import ToolsGrid from '../components/ToolsGrid.astro';
import ContactCta from '../components/ContactCta.astro';
---

<Layout>
  <div id="top">
    <TopNav />

    <main class="container-width">
      <section class="hero" aria-label="Introduction">
        <ProfileCard />
        <HeroCopy />
      </section>

      <ProjectsGrid />
      <ExperienceList />
      <ToolsGrid />
      <ContactCta />
    </main>
  </div>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(300px, 380px) minmax(0, 1fr);
    gap: 48px;
    align-items: stretch;
    padding-top: 108px;
  }
  @media screen and (max-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 560px);
      justify-content: center;
    }
  }
  @media screen and (max-width: 640px) {
    .hero {
      padding-top: 96px;
      gap: 36px;
    }
  }
</style>
